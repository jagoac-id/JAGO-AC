rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner() {
      return isSignedIn() && 
             request.auth.token.email in ['anjaspratama0987@gmail.com'];
    }

    function isAdmin() { 
      return isOwner() || 
             (isSignedIn() && 
              exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); 
    }
    
    // Primitive Validation
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phone', 'address', 'area', 'date', 'time', 'items', 'subTotal', 'total', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.address is string && data.address.size() <= 300 &&
             data.area is string && data.area.size() <= 100 &&
             data.date is string && data.date.size() <= 20 &&
             data.time is string && data.time.size() <= 20 &&
             data.items is list && data.items.size() <= 20 &&
             data.subTotal is number && data.subTotal >= 0 &&
             data.total is number && data.total >= 0 &&
             data.status is string && data.status in ['Pending', 'Sedang Dikerjakan', 'Selesai', 'Dibatalkan'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('technician' in data.keys()) || (data.technician is string && data.technician.size() <= 100)) &&
             (!('extraCosts' in data.keys()) || (data.extraCosts is list && data.extraCosts.size() <= 10));
    }

    match /promos/{promoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['usedTotal', 'usedToday', 'lastUsedDate'])
      );
    }

    match /orders/{orderId} {
      allow list, get: if true;
      allow delete: if isAdmin();
      
      // Allow anyone to create an order.
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      
      // Admin overrides
      allow update: if isAdmin();
    }

    match /technicianReports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() || true; // Explicitly allow for now, but keeping isSignedIn as a hint
      allow update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /technicians/{techId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    match /audit_logs/{id} {
      allow read: if isOwner();
      allow create: if isAdmin();
    }
  }
}
